# @tripician/graphics (icons, colours, doodle settings) comes from the org's
# private GitHub Packages registry; everything else still comes from npmjs.
# NPM_TOKEN is a GitHub classic token with only read:packages. Set it as a
# user environment variable on your machine and in Vercel's Environment
# Variables; this file holds no secret, only the variable's name.
@tripician:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
